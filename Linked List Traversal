# Linked List Traversal
# pseudocode
BEGIN
    CREATE node1 = 10
    CREATE node2 = 20
    CREATE node3 = 30
    node1.next = node2
    node2.next = node3
    current = node1
    WHILE current is not NULL DO
        PRINT current.data
        current = current.next
    END WHILE
END

# implementasi python
class Node:
    def _init_(self, data):
        self.data = data
        self.next = None

# Membuat node
node1 = Node(10)
node2 = Node(20)
node3 = Node(30)

# Menghubungkan node
node1.next = node2
node2.next = node3

# Traversal
current = node1
while current:
    print(current.data)
    current = current.next
