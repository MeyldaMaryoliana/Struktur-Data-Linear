# Stack untuk membalik kata
# pseudocode
BEGIN
    INPUT word
    stack = empty
    FOR each character in word DO
        PUSH character to stack
    END FOR
    result = ""
    WHILE stack is not empty DO
        result = result + POP stack
    END WHILE
    PRINT result
END

# implementasi python
stack = []
kata = input("masukkan kata:")

for huruf in kata:
    stack.append(huruf)

hasil = ""
while stack:
    hasil += stack.pop()

print("Hasil:", hasil)
